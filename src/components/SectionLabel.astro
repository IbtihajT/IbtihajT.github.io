---
interface Props {
  /** e.g. "01 / About" */
  text: string;
}
const { text } = Astro.props;
---

<div class="section-label">
  <span>{text}</span>
</div>

<style>
  .section-label {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-primary);
    margin-bottom: 18px;
    opacity: 0.9;
  }

  .section-label::before {
    content: "";
    display: inline-block;
    width: 24px;
    height: 1px;
    background: var(--color-primary);
  }
</style>

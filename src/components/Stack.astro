---
import SectionLabel from "./SectionLabel.astro";

type Chip = { name: string; icon: string };
type Group = { label: string; chips: Chip[] };

const groups: Group[] = [
  {
    label: "Core Languages & Data",
    chips: [
      { name: "Python",     icon: "/images/MyStack/python.svg" },
      { name: "Bash",       icon: "/images/MyStack/bash.svg" },
      { name: "PostgreSQL", icon: "/images/MyStack/PostgresSQL.svg" },
      { name: "Pandas",     icon: "/images/MyStack/Pandas.svg" },
    ],
  },
  {
    label: "ML & Deep Learning Frameworks",
    chips: [
      { name: "PyTorch",      icon: "/images/MyStack/PyTorch.svg" },
      { name: "TensorFlow",   icon: "/images/MyStack/TensorFlow.svg" },
      { name: "scikit-learn", icon: "/images/MyStack/scikit-learn.svg" },
    ],
  },
];
---

<section id="stack" class="stack-section">
  <div class="stack-container">

    <header class="section-header">
      <SectionLabel text="04 / Stack" />
      <h2 class="section-heading">
        My <span class="text-gradient">Tech Stack</span>
      </h2>
      <p class="section-sub">
        The tools and frameworks I use to build and ship intelligent systems.
      </p>
    </header>

    {groups.map((g) => (
      <div class="stack-group">
        <div class="stack-category-label">{g.label}</div>
        <ul class="stack-row">
          {g.chips.map((c) => (
            <li class="stack-chip">
              <img
                src={c.icon}
                alt={c.name}
                width="26"
                height="26"
                loading="lazy"
                decoding="async"
              />
              <span>{c.name}</span>
            </li>
          ))}
        </ul>
      </div>
    ))}

  </div>
</section>

<style>
  .stack-section {
    background: var(--color-bg-1);
    padding: 110px 0;
  }

  .stack-container {
    max-width: 1320px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }
  @media (min-width: 1024px) {
    .stack-container { padding: 0 2.5rem; }
  }

  /* ---------- Section header ---------- */
  .section-header {
    margin-bottom: 64px;
    max-width: 720px;
  }

  .section-heading {
    font-family: var(--font-display);
    font-size: clamp(36px, 4.5vw, 62px);
    font-weight: 800;
    line-height: 1.08;
    letter-spacing: -0.03em;
    color: var(--color-text);
    margin: 0 0 16px;
  }

  .section-sub {
    font-family: var(--font-body);
    font-size: 17px;
    color: var(--color-text-muted);
    line-height: 1.75;
    margin: 0;
  }

  /* ---------- Group ---------- */
  .stack-group {
    margin-bottom: 52px;
  }

  .stack-group:last-child {
    margin-bottom: 0;
  }

  .stack-category-label {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-text-dim);
    margin-bottom: 20px;
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .stack-category-label::after {
    content: "";
    flex: 1;
    height: 1px;
    background: var(--color-edge);
  }

  /* ---------- Row of chips ---------- */
  .stack-row {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  /* ---------- Chip ---------- */
  .stack-chip {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 13px 22px;
    background: var(--color-glass);
    border: 1px solid var(--color-edge);
    border-radius: var(--radius-md);
    transition: background 0.3s var(--ease-default),
                border-color 0.3s var(--ease-default),
                box-shadow 0.3s var(--ease-default);
    cursor: default;
  }

  /* No-lift hover — centered glow, per design feedback. */
  .stack-chip:hover {
    background: var(--color-glass-hover);
    border-color: var(--color-primary-border);
    box-shadow:
      0 0 0 1px rgba(124, 58, 237, 0.18),
      0 0 36px rgba(124, 58, 237, 0.18);
  }

  .stack-chip img {
    width: 26px;
    height: 26px;
    object-fit: contain;
    flex-shrink: 0;
  }

  .stack-chip span {
    font-size: 14px;
    font-weight: 500;
    color: var(--color-text);
    font-family: var(--font-body);
    white-space: nowrap;
  }

  /* ---------- Mobile (≤767px) ---------- */
  @media (max-width: 767px) {
    .stack-section { padding: 80px 0; }
    .section-header { margin-bottom: 40px; }
    .section-heading { font-size: clamp(30px, 8vw, 50px); }
    .stack-group { margin-bottom: 40px; }
    .stack-chip { padding: 11px 18px; }
    .stack-chip img { width: 22px; height: 22px; }
  }
</style>

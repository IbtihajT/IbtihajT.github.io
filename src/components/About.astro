---
import SectionLabel from "./SectionLabel.astro";

const skills = [
  "End-to-End ML",
  "MLOps",
  "Deep Learning",
  "Computer Vision",
  "NLP",
  "Data Pipelines",
  "Model Evaluation",
];

const stats = [
  { num: "4+",  label: "Years Experience" },
  { num: "10+", label: "ML Projects"      },
];
---

<section id="about" class="about-section">
  <div class="about-container">

    <div class="about-grid">

      <div class="about-image-col">
        <div class="about-image-wrap">
          <img
            src="/images/MyStack/Dp.webp"
            alt="Muhammad Ibtihaj Tahir"
            class="about-img"
            loading="lazy"
            decoding="async"
            width="460"
            height="575"
          />
          <div class="about-image-glow" aria-hidden="true"></div>
          {stats.map((s, i) => (
            <div class={`about-stat-chip chip-${i + 1}`}>
              <span class="chip-num text-gradient">{s.num}</span>
              <span class="chip-label">{s.label}</span>
            </div>
          ))}
        </div>
      </div>

      <div class="about-text-col">
        <SectionLabel text="01 / About" />

        <h2 class="about-heading">
          I turn <span class="text-gradient">complex data</span> into<br />
          <span class="text-gradient">actionable intelligence.</span>
        </h2>

        <p class="about-body">
          As an <strong>AI and Machine Learning Specialist</strong>, I deliver
          end-to-end data-driven solutions — from raw data pipelines to
          production-ready models. I design scalable ML architectures
          supporting reliable training, validation, and deployment workflows.
        </p>

        <p class="about-body">
          I bridge research and production by implementing efficient
          <strong>MLOps pipelines</strong>, automating model deployment,
          monitoring, and retraining. With deep technical expertise and a
          collaborative mindset, I drive the full lifecycle of AI initiatives —
          from problem definition to production-ready solutions.
        </p>

        <ul class="about-tags">
          {skills.map((s) => <li class="a-tag">{s}</li>)}
        </ul>
      </div>

    </div>
  </div>
</section>

<style>
  .about-section {
    background: var(--color-bg);
    padding: 110px 0;
    position: relative;
  }

  .about-container {
    max-width: 1320px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }
  @media (min-width: 1024px) {
    .about-container { padding: 0 2.5rem; }
  }

  .about-grid {
    display: grid;
    gap: 3rem;
    align-items: center;
  }
  @media (min-width: 1024px) {
    .about-grid {
      grid-template-columns: 5fr 7fr;
      gap: 4rem;
    }
  }

  /* ---------- Image column ---------- */
  .about-image-wrap {
    position: relative;
    display: block;
    width: 100%;
    max-width: 460px;
    margin: 0 auto;
  }

  .about-img {
    width: 100%;
    border-radius: var(--radius-2xl);
    object-fit: cover;
    aspect-ratio: 4 / 5;
    display: block;
    filter: grayscale(10%) contrast(1.04);
    transition: filter 0.5s var(--ease-default);
  }

  .about-image-wrap:hover .about-img {
    filter: grayscale(0%) contrast(1);
  }

  .about-image-glow {
    position: absolute;
    inset: -2px;
    border-radius: var(--radius-2xl);
    background: linear-gradient(135deg, rgba(124, 58, 237, 0.35), rgba(34, 211, 238, 0.2));
    z-index: -1;
    filter: blur(24px);
    opacity: 0.5;
    transition: opacity 0.5s var(--ease-default);
  }

  .about-image-wrap:hover .about-image-glow {
    opacity: 0.8;
  }

  /* Stat chips */
  .about-stat-chip {
    position: absolute;
    background: rgba(12, 12, 30, 0.88);
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    border: 1px solid var(--color-edge);
    border-radius: var(--radius-md);
    padding: 14px 22px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 3px;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.4);
  }

  .chip-1 { bottom: 32px; left: -28px; }
  .chip-2 { top: 32px;    right: -28px; }

  .chip-num {
    font-family: var(--font-display);
    font-size: 30px;
    font-weight: 800;
    line-height: 1;
  }

  .chip-label {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    white-space: nowrap;
  }

  /* ---------- Text column ---------- */
  .about-heading {
    font-family: var(--font-display);
    font-size: clamp(36px, 4.5vw, 62px);
    font-weight: 800;
    line-height: 1.18;
    letter-spacing: -0.025em;
    color: var(--color-text);
    margin: 0 0 28px;
  }

  .about-body {
    font-family: var(--font-body);
    font-size: 16px;
    color: var(--color-text-muted);
    line-height: 1.82;
    margin: 0 0 18px;
  }

  .about-body strong {
    color: var(--color-text);
    font-weight: 600;
  }

  /* Skill tags */
  .about-tags {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin: 36px 0 0;
  }

  .a-tag {
    display: inline-flex;
    align-items: center;
    padding: 7px 16px;
    background: var(--color-primary-dim);
    border: 1px solid var(--color-primary-border);
    border-radius: 100px;
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 500;
    color: var(--color-primary-light);
    letter-spacing: 0.01em;
    transition: all 0.25s var(--ease-default);
  }

  .a-tag:hover {
    background: rgba(124, 58, 237, 0.22);
    border-color: rgba(124, 58, 237, 0.55);
  }

  /* ---------- Mobile (≤767px) ---------- */
  @media (max-width: 767px) {
    .about-section { padding: 80px 0; }

    .about-image-wrap {
      max-width: 100%;
    }

    /* Hide floating stat chips on small screens to avoid overflow */
    .about-stat-chip {
      display: none;
    }

    .about-heading {
      font-size: clamp(30px, 8vw, 50px);
    }
  }
</style>

---
import { Icon } from "astro-icon/components";

const navItems = [
  { label: "Home", href: "#home" },
  { label: "About", href: "#about" },
  { label: "Projects", href: "#projects" },
  { label: "Services", href: "#services" },
  { label: "Stack", href: "#stack" },
];

const cta = { label: "Contact", href: "#contact" };
---

<header id="site-header" class="site-header">
  <div class="mx-auto flex h-20 max-w-[1320px] items-center justify-between px-6 lg:px-10">

    <a href="#home" aria-label="Home" class="logo">
      <img
        src="/images/MyStack/Logo.svg"
        alt="Ibtihaj Tahir"
        width="88"
        height="32"
      />
    </a>

    <nav aria-label="Primary" class="hidden items-center lg:flex">
      <ul class="flex items-center">
        {navItems.map((item) => (
          <li>
            <a href={item.href} class="nav-link" data-nav-link>
              {item.label}
            </a>
          </li>
        ))}
      </ul>
      <a href={cta.href} class="nav-cta">{cta.label}</a>
    </nav>

    <button
      id="menu-toggle"
      type="button"
      class="menu-btn lg:hidden"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <Icon name="lucide:menu" class="h-6 w-6" />
    </button>

  </div>
</header>

<div
  id="mobile-menu"
  class="mobile-menu"
  aria-hidden="true"
>
  <div class="mobile-menu-header">
    <button
      id="menu-close"
      type="button"
      class="close-btn"
      aria-label="Close menu"
    >
      <Icon name="lucide:x" class="h-6 w-6" />
    </button>
  </div>
  <ul class="mobile-menu-list">
    {[...navItems, cta].map((item) => (
      <li>
        <a href={item.href} class="mobile-link" data-mobile-link>
          {item.label}
        </a>
      </li>
    ))}
  </ul>
</div>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto 0;
    background: transparent;
    border-bottom: 1px solid transparent;
    transition:
      background 0.35s var(--ease-default),
      backdrop-filter 0.35s var(--ease-default),
      border-color 0.35s var(--ease-default),
      transform 0.35s var(--ease-default);
    z-index: 50;
  }

  .site-header.scrolled {
    background: rgba(6, 6, 15, 0.82);
    backdrop-filter: blur(24px) saturate(1.4);
    -webkit-backdrop-filter: blur(24px) saturate(1.4);
    border-bottom-color: var(--color-edge);
  }

  .nav-link {
    display: inline-block;
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 500;
    color: var(--color-text-muted);
    transition: color 0.22s;
    padding: 6px 0;
    margin: 0 16px;
  }

  .nav-link:hover,
  .nav-link.active {
    color: var(--color-text);
  }

  .nav-cta {
    background: var(--color-primary);
    color: #fff;
    padding: 8px 22px;
    border-radius: 100px;
    font-weight: 600;
    font-size: 13px;
    letter-spacing: 0.02em;
    transition: all 0.28s var(--ease-default);
    margin-left: 12px;
  }

  .nav-cta:hover {
    background: #6d28d9;
    box-shadow: 0 0 28px var(--color-primary-glow);
  }

  .menu-btn,
  .close-btn {
    color: var(--color-text);
    background: transparent;
    border: none;
    padding: 8px;
    cursor: pointer;
    transition: color 0.2s;
  }

  .menu-btn:hover,
  .close-btn:hover {
    color: var(--color-primary);
  }

  .mobile-menu {
    position: fixed;
    inset: 0;
    background: var(--color-bg-1);
    border-left: 1px solid var(--color-edge);
    z-index: 100;
    transform: translateX(100%);
    transition: transform 0.4s var(--ease-default);
    display: flex;
    flex-direction: column;
  }

  .mobile-menu.open {
    transform: translateX(0);
  }

  .mobile-menu-header {
    display: flex;
    justify-content: flex-end;
    padding: 1.5rem;
  }

  .mobile-menu-list {
    list-style: none;
    padding: 1rem 2rem 2rem;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .mobile-link {
    font-family: var(--font-body);
    font-size: 22px;
    font-weight: 700;
    color: var(--color-text);
    letter-spacing: -0.02em;
    transition: color 0.2s;
  }

  .mobile-link:hover {
    color: var(--color-primary);
  }
</style>

<script>
  const header = document.getElementById("site-header");
  let ticking = false;

  function onScroll() {
    if (window.scrollY > 20) header?.classList.add("scrolled");
    else header?.classList.remove("scrolled");
    ticking = false;
  }

  window.addEventListener(
    "scroll",
    () => {
      if (!ticking) {
        requestAnimationFrame(onScroll);
        ticking = true;
      }
    },
    { passive: true }
  );

  const toggle = document.getElementById("menu-toggle");
  const close = document.getElementById("menu-close");
  const menu = document.getElementById("mobile-menu");

  function openMenu() {
    menu?.classList.add("open");
    menu?.setAttribute("aria-hidden", "false");
    toggle?.setAttribute("aria-expanded", "true");
    document.body.style.overflow = "hidden";
  }

  function closeMenu() {
    menu?.classList.remove("open");
    menu?.setAttribute("aria-hidden", "true");
    toggle?.setAttribute("aria-expanded", "false");
    document.body.style.overflow = "";
  }

  toggle?.addEventListener("click", openMenu);
  close?.addEventListener("click", closeMenu);
  menu?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", closeMenu);
  });

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && menu?.classList.contains("open")) closeMenu();
  });
</script>
